{
  "info": {
    "name": "SACCOS Admin API - Quick Tests",
    "_postman_id": "saccos-admin-collection",
    "description": "Collection for testing server admin endpoints. Set environment variable BASE_URL and ADMIN_API_KEY before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{BASE_URL}}/api/health", "host": ["{{BASE_URL}}"], "path": ["api","health"] }
      }
    },
    {
      "name": "Admin: List Institutions",
      "request": {
        "method": "GET",
        "header": [ { "key": "x-admin-key", "value": "{{ADMIN_API_KEY}}" } ],
        "url": { "raw": "{{BASE_URL}}/api/admin/institutions", "host":["{{BASE_URL}}"], "path":["api","admin","institutions"] }
      }
    },
    {
      "name": "Admin: Create Institution (simple)",
      "request": {
