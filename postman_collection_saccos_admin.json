        "header": [ { "key": "x-admin-key", "value": "{{ADMIN_API_KEY}}" }, { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Production Test Inst\",\n  \"type\": \"SACCOS\",\n  \"registration_number\": \"REG/PROD/001\",\n  \"phone\": \"+255700000200\",\n  \"email\": \"ops@prod.tz\",\n  \"region\": \"Dar es Salaam\",\n  \"currency\": \"TZS\"\n}"
        },
        "url": { "raw": "{{BASE_URL}}/api/admin/institutions", "host":["{{BASE_URL}}"], "path":["api","admin","institutions"] }
      }
    },
