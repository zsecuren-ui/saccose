# SACCOS PLATFORM - Production Environment Template
# Copy to .env.production or set these variables in Render / VPS / hosting provider

NODE_ENV=production
PORT=3000

# Frontend runtime
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend only - keep secret and NEVER expose in browser/client code
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_URL=https://your-project-ref.supabase.co

# Server admin auth
ADMIN_API_KEY=replace-with-a-long-random-secret

# Optional integrations
GEMINI_API_KEY=your_gemini_api_key_here
APP_URL=https://your-domain.example.com

# Optional compatibility aliases if some scripts read VITE_ prefixed service-role names
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
