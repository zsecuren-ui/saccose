const { data: { user }, error } = await supabase.auth.getUser();

if (!user) {
  console.log('User not logged in');
} else {
  const { data, error: insertError } = await supabase
    .from('announcements')
    .insert([
      {
        content: 'Announcement ya kweli kutoka production',
        status: 'published',
        author_id: user.id
      }
    ])
    .select();

  console.log(insertError || data);
}
